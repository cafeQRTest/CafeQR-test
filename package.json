{
  "name": "restaurant-qr-app-clean",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "cross-env NATIVE_BUILD=1 next build",
    "start": "next start",
    "export": "next export",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "dev:tunnel": "cross-env NODE_ENV=development localtunnel --port 3000",
    "build:analyze": "cross-env ANALYZE=true next build",
    "cap:pos:test": "cross-env CAFEQR_TARGET=pos-test node scripts/use-android-target.js android-pos-test && (if not exist android\\ npx cap add android) && (if not exist android\\app\\src\\main\\assets\\ mkdir android\\app\\src\\main\\assets) && (if not exist android\\app\\src\\main\\assets\\public\\ mkdir android\\app\\src\\main\\assets\\public) && npx cap sync android",
    "cap:delivery:test": "cross-env CAFEQR_TARGET=delivery-test node scripts/use-android-target.js android-delivery-test && (if not exist android\\ npx cap add android) && (if not exist android\\app\\src\\main\\assets\\ mkdir android\\app\\src\\main\\assets) && (if not exist android\\app\\src\\main\\assets\\public\\ mkdir android\\app\\src\\main\\assets\\public) && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/cli": "6.0.0",
    "@capacitor/core": "6.0.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "6.0.0",
    "@capacitor/preferences": "6.0.0",
    "@capacitor/push-notifications": "6.0.0",
    "@capacitor/share": "^6.0.4",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "canvas": "^3.2.0",
    "clsx": "^2.1.1",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.29.2",
    "get-stream": "^9.0.1",
    "google-auth-library": "^10.3.0",
    "json-2-csv": "^5.5.9",
    "json2csv": "^6.0.0-alpha.2",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.563.0",
    "next": "14.2.32",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.9",
    "openai": "^6.9.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "styled-components": "^6.1.19",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.25",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "localtunnel": "^1.8.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.2"
  }
}
